{
  "openapi": "3.1.1",
  "info": {
    "title": "Roman.RedisManager.Web | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/commands/info": {
      "get": {
        "tags": [
          "RedisInfo"
        ],
        "parameters": [
          {
            "name": "groupId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "host",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "port",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/RedisInfoQueryResult"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RedisInfoQueryResult"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/RedisInfoQueryResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/redis-server-groups": {
      "get": {
        "tags": [
          "RedisServerGroups"
        ],
        "parameters": [
          {
            "name": "pageNumber",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/RedisServerGroupsQueryResult"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RedisServerGroupsQueryResult"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/RedisServerGroupsQueryResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/redis-server-groups/{id}": {
      "get": {
        "tags": [
          "RedisServerGroups"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/RedisServerGroupDetailQueryResult"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RedisServerGroupDetailQueryResult"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/RedisServerGroupDetailQueryResult"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GroupType": {
        "enum": [
          "Standalone",
          "Cluster"
        ]
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RedisInfoQueryResult": {
        "required": [
          "sections"
        ],
        "type": "object",
        "properties": {
          "sections": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        }
      },
      "RedisServerGroupDetailQueryResult": {
        "required": [
          "nodes"
        ],
        "type": "object",
        "properties": {
          "nodes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RedisServerNodeDto"
            }
          }
        }
      },
      "RedisServerGroupDto": {
        "required": [
          "name",
          "id",
          "groupType"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "groupType": {
            "$ref": "#/components/schemas/GroupType"
          }
        }
      },
      "RedisServerGroupsQueryResult": {
        "required": [
          "serverGroups",
          "totalCount",
          "pageNumber",
          "pageSize"
        ],
        "type": "object",
        "properties": {
          "serverGroups": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RedisServerGroupDto"
            }
          },
          "totalCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "pageNumber": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "pageSize": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "RedisServerNodeDto": {
        "required": [
          "host",
          "port",
          "role"
        ],
        "type": "object",
        "properties": {
          "host": {
            "type": "string"
          },
          "port": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "role": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "RedisInfo"
    },
    {
      "name": "RedisServerGroups"
    }
  ]
}