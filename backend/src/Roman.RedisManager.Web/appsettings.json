{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ContinuationToken": {
    "TokenSecret": "change-me-development-token-secret",
    "TokenTtlMinutes": 60
  },
  "Security": {
    "Authentication": {
      "Providers": [
        {
          "ProviderKey": "entra",
          "DisplayName": "Entra ID",
          "Enabled": true,
          "Kind": "EntraId",
          "Authority": "https://login.microsoftonline.com/common/v2.0",
          "ClientId": "entra-client-id",
          "ValidateAudience": false,
          "BootstrapRedirectUri": "https://frontend.example.com/auth/callback",
          "BootstrapScope": "openid profile email",
          "BootstrapResponseType": "code",
          "BootstrapPostLogoutRedirectUri": "https://frontend.example.com/auth/logout-callback",
          "BootstrapSilentRedirectUri": "https://frontend.example.com/auth/silent-callback",
          "BootstrapAutomaticSilentRenew": true
        },
        {
          "ProviderKey": "google",
          "DisplayName": "Google",
          "Enabled": true,
          "Kind": "Google",
          "Authority": "https://accounts.google.com",
          "ClientId": "google-client-id",
          "ValidateAudience": false,
          "BootstrapRedirectUri": "https://frontend.example.com/auth/callback",
          "BootstrapScope": "openid profile email",
          "BootstrapResponseType": "code",
          "BootstrapPostLogoutRedirectUri": "https://frontend.example.com/auth/logout-callback",
          "BootstrapSilentRedirectUri": "https://frontend.example.com/auth/silent-callback",
          "BootstrapAutomaticSilentRenew": true
        },
        {
          "ProviderKey": "generic",
          "DisplayName": "Generic OIDC",
          "Enabled": true,
          "Kind": "GenericOidc",
          "Authority": "https://issuer.example.com",
          "ClientId": "generic-client-id",
          "ValidateAudience": false,
          "BootstrapRedirectUri": "https://frontend.example.com/auth/callback",
          "BootstrapScope": "openid profile email api offline_access",
          "BootstrapResponseType": "code",
          "BootstrapPostLogoutRedirectUri": "https://frontend.example.com/auth/logout-callback",
          "BootstrapSilentRedirectUri": "https://frontend.example.com/auth/silent-callback",
          "BootstrapAutomaticSilentRenew": true,
          "BootstrapMetadataIssuer": "https://issuer.example.com",
          "BootstrapMetadataAuthorizationEndpoint": "https://issuer.example.com/connect/authorize",
          "BootstrapMetadataTokenEndpoint": "https://issuer.example.com/connect/token",
          "BootstrapMetadataUserInfoEndpoint": "https://issuer.example.com/connect/userinfo",
          "BootstrapMetadataEndSessionEndpoint": "https://issuer.example.com/connect/endsession"
        }
      ]
    },
    "Authorization": {
      "Roles": [
        {
          "RoleName": "reader",
          "Description": "Read-only access"
        },
        {
          "RoleName": "editor",
          "Description": "Read and modify access"
        },
        {
          "RoleName": "admin",
          "Description": "Administrative access"
        }
      ],
      "RoleClaimMappings": [
        {
          "RoleName": "reader",
          "ProviderKey": "entra",
          "ClaimKey": "groups",
          "AllowedValues": [
            "admin_group"
          ],
          "MatchMode": "Any"
        },
        {
          "RoleName": "reader",
          "ProviderKey": "google",
          "ClaimKey": "groups",
          "AllowedValues": [
            "readers"
          ],
          "MatchMode": "Any"
        },
        {
          "RoleName": "admin",
          "ProviderKey": "generic",
          "ClaimKey": "roles",
          "AllowedValues": [
            "redis-admin"
          ],
          "MatchMode": "Any"
        }
      ]
    }
  },
  "Redis": {
    "Search": {
      "MaxPageSize": 100
    },
    "ServerGroups": [
      {
        "Id": "11111111-1111-1111-1111-111111111111",
        "Name": "TestRedis",
        "ConnectionString": "localhost:8000",
        "GroupType": "Standalone"
      },
      {
        "Id": "22222222-2222-2222-2222-222222222222",
        "Name": "TestRedisViaSlave",
        "ConnectionString": "localhost:8001",
        "GroupType": "Standalone"
      }
    ]
  }
}
