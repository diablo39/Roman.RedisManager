{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ContinuationToken": {
    "TokenSecret": "change-me-development-token-secret",
    "TokenTtlMinutes": 60
  },
  "Security": {
    "Authentication": {
      "Providers": [
        {
          "ProviderKey": "entra",
          "DisplayName": "Entra ID",
          "Enabled": true,
          "Kind": "EntraId",
          "Authority": "https://login.microsoftonline.com/common/v2.0",
          "ClientId": "entra-client-id",
          "ClientSecret": "entra-client-secret"
        },
        {
          "ProviderKey": "google",
          "DisplayName": "Google",
          "Enabled": true,
          "Kind": "Google",
          "Authority": "https://accounts.google.com",
          "ClientId": "google-client-id",
          "ClientSecret": "google-client-secret"
        },
        {
          "ProviderKey": "generic",
          "DisplayName": "Generic OIDC",
          "Enabled": true,
          "Kind": "GenericOidc",
          "Authority": "https://issuer.example.com",
          "ClientId": "generic-client-id",
          "ClientSecret": "generic-client-secret",
          "MetadataAddress": "https://issuer.example.com/.well-known/openid-configuration"
        }
      ]
    },
    "Authorization": {
      "Roles": [
        {
          "RoleName": "redis-reader",
          "Description": "Read-only access"
        },
        {
          "RoleName": "editor",
          "Description": "Read and modify access"
        },
        {
          "RoleName": "admin",
          "Description": "Administrative access"
        }
      ],
      "RoleClaimMappings": [
        {
          "RoleName": "redis-reader",
          "ProviderKey": "entra",
          "ClaimKey": "groups",
          "AllowedValues": [
            "admin_group"
          ],
          "MatchMode": "Any"
        },
        {
          "RoleName": "redis-reader",
          "ProviderKey": "google",
          "ClaimKey": "groups",
          "AllowedValues": [
            "readers"
          ],
          "MatchMode": "Any"
        },
        {
          "RoleName": "admin",
          "ProviderKey": "generic",
          "ClaimKey": "roles",
          "AllowedValues": [
            "redis-admin"
          ],
          "MatchMode": "Any"
        }
      ],
      "Permissions": {
        "Global": [
          {
            "Action": "ReadKeys",
            "AllowedRoles": [
              "redis-reader",
              "editor",
              "admin"
            ]
          },
          {
            "Action": "DeleteKey",
            "AllowedRoles": [
              "editor",
              "admin"
            ]
          }
        ]
      }
    }
  },
  "Redis": {
    "Search": {
      "MaxPageSize": 100
    },
    "ServerGroups": [
      {
        "Id": "11111111-1111-1111-1111-111111111111",
        "Name": "TestRedis",
        "ConnectionString": "localhost:8000",
        "GroupType": "Standalone",
        "AuthorizationOverrides": {
          "Mode": "ReplaceDefaults",
          "Rules": [
            {
              "Action": "DeleteKey",
              "AllowedRoles": [
                "admin"
              ]
            }
          ]
        }
      },
      {
        "Id": "22222222-2222-2222-2222-222222222222",
        "Name": "TestRedisViaSlave",
        "ConnectionString": "localhost:8001",
        "GroupType": "Standalone"
      }
    ]
  }
}
