{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ContinuationToken": {
    "TokenSecret": "development-only-token-secret-change-me",
    "TokenTtlMinutes": 60
  },
  "Security": {
    "Authentication": {
      "Providers": [
        {
          "ProviderKey": "entra",
          "DisplayName": "Entra ID Dev",
          "Enabled": true,
          "Kind": "EntraId",
          "Authority": "https://login.microsoftonline.com/common/v2.0",
          "ClientId": "dbdde03c-b139-47f1-b076-63b2bf78cabe",
          "ValidateAudience": false,
          "BootstrapRedirectUri": "http://localhost:3000/auth/callback",
          "BootstrapScope": "openid profile email",
          "BootstrapResponseType": "code",
          "BootstrapPostLogoutRedirectUri": "http://localhost:3000/auth/logout-callback",
          "BootstrapSilentRedirectUri": "http://localhost:3000/auth/silent-callback",
          "BootstrapAutomaticSilentRenew": true
        },
        {
          "ProviderKey": "google",
          "DisplayName": "Google Dev",
          "Enabled": true,
          "Kind": "Google",
          "Authority": "https://accounts.google.com",
          "ClientId": "dev-google-client-id",
          "ValidateAudience": false,
          "BootstrapRedirectUri": "http://localhost:5173/auth/callback",
          "BootstrapScope": "openid profile email",
          "BootstrapResponseType": "code",
          "BootstrapPostLogoutRedirectUri": "http://localhost:5173/auth/logout-callback",
          "BootstrapSilentRedirectUri": "http://localhost:5173/auth/silent-callback",
          "BootstrapAutomaticSilentRenew": true
        },
        {
          "ProviderKey": "generic",
          "DisplayName": "Generic OIDC Dev",
          "Enabled": true,
          "Kind": "GenericOidc",
          "Authority": "https://issuer.dev.local",
          "ClientId": "dev-generic-client-id",
          "ValidateAudience": false,
          "BootstrapRedirectUri": "http://localhost:5173/auth/callback",
          "BootstrapScope": "openid profile email api offline_access",
          "BootstrapResponseType": "code",
          "BootstrapPostLogoutRedirectUri": "http://localhost:5173/auth/logout-callback",
          "BootstrapSilentRedirectUri": "http://localhost:5173/auth/silent-callback",
          "BootstrapAutomaticSilentRenew": true,
          "BootstrapMetadataIssuer": "https://issuer.dev.local",
          "BootstrapMetadataAuthorizationEndpoint": "https://issuer.dev.local/connect/authorize",
          "BootstrapMetadataTokenEndpoint": "https://issuer.dev.local/connect/token",
          "BootstrapMetadataUserInfoEndpoint": "https://issuer.dev.local/connect/userinfo",
          "BootstrapMetadataEndSessionEndpoint": "https://issuer.dev.local/connect/endsession"
        }
      ]
    },
    "Authorization": {
      "Roles": [
        { "RoleName": "reader", "Description": "Read-only access" },
        { "RoleName": "editor", "Description": "Read and modify access" },
        { "RoleName": "admin", "Description": "Administrative access" }
      ],
      "RoleClaimMappings": [
        {
          "RoleName": "reader",
          "ProviderKey": "entra",
          "ClaimKey": "roles",
          "AllowedValues": [ "reader" ],
          "MatchMode": "Any"
        },
        {
          "RoleName": "editor",
          "ProviderKey": "entra",
          "ClaimKey": "roles",
          "AllowedValues": [ "editor" ],
          "MatchMode": "Any"
        },
        {
          "RoleName": "admin",
          "ProviderKey": "entra",
          "ClaimKey": "roles",
          "AllowedValues": [ "admin" ],
          "MatchMode": "Any"
        }
      ]
    }
  },
  "Redis": {
    "Search": {
      "MaxPageSize": 50
    },
    "ServerGroups": [
      {
        "Id": "11111111-1111-1111-1111-111111111111",
        "Name": "TestRedis",
        "ConnectionString": "localhost:8000,localhost:8001,allowAdmin=true,abortConnect=false",
        "GroupType": "Standalone"
      },
      {
        "Id": "33333333-3333-3333-3333-333333333333",
        "Name": "RedisCluster",
        "ConnectionString": "127.0.0.1:7000,allowAdmin=true,abortConnect=false",
        "GroupType": "Cluster"
      }
    ]
  }
}
