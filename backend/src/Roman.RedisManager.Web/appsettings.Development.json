{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ContinuationToken": {
    "TokenSecret": "development-only-token-secret-change-me",
    "TokenTtlMinutes": 60
  },
  "Security": {
    "Authentication": {
      "Providers": [
        {
          "ProviderKey": "entra",
          "DisplayName": "Entra ID Dev",
          "Enabled": true,
          "Kind": "EntraId",
          "Authority": "https://login.microsoftonline.com/common/v2.0",
          "ClientId": "dev-entra-client-id",
          "ClientSecret": "dev-entra-client-secret"
        },
        {
          "ProviderKey": "google",
          "DisplayName": "Google Dev",
          "Enabled": true,
          "Kind": "Google",
          "Authority": "https://accounts.google.com",
          "ClientId": "dev-google-client-id",
          "ClientSecret": "dev-google-client-secret"
        },
        {
          "ProviderKey": "generic",
          "DisplayName": "Generic OIDC Dev",
          "Enabled": true,
          "Kind": "GenericOidc",
          "Authority": "https://issuer.dev.local",
          "ClientId": "dev-generic-client-id",
          "ClientSecret": "dev-generic-client-secret",
          "MetadataAddress": "https://issuer.dev.local/.well-known/openid-configuration"
        }
      ]
    },
    "Authorization": {
      "Roles": [
        { "RoleName": "redis-reader", "Description": "Read-only access" },
        { "RoleName": "editor", "Description": "Read and modify access" },
        { "RoleName": "admin", "Description": "Administrative access" }
      ],
      "RoleClaimMappings": [
        {
          "RoleName": "redis-reader",
          "ProviderKey": "entra",
          "ClaimKey": "groups",
          "AllowedValues": [ "admin_group" ],
          "MatchMode": "Any"
        },
        {
          "RoleName": "editor",
          "ProviderKey": "google",
          "ClaimKey": "groups",
          "AllowedValues": [ "editors" ],
          "MatchMode": "Any"
        },
        {
          "RoleName": "admin",
          "ProviderKey": "generic",
          "ClaimKey": "roles",
          "AllowedValues": [ "redis-admin" ],
          "MatchMode": "Any"
        }
      ],
      "Permissions": {
        "Global": [
          { "Action": "ReadKeys", "AllowedRoles": [ "redis-reader", "editor", "admin" ] },
          { "Action": "DeleteKey", "AllowedRoles": [ "editor", "admin" ] }
        ]
      }
    }
  },
  "Redis": {
    "Search": {
      "MaxPageSize": 50
    },
    "ServerGroups": [
      {
        "Id": "11111111-1111-1111-1111-111111111111",
        "Name": "TestRedis",
        "ConnectionString": "localhost:8000,localhost:8001,allowAdmin=true,abortConnect=false",
        "GroupType": "Standalone"
      },
      {
        "Id": "33333333-3333-3333-3333-333333333333",
        "Name": "RedisCluster",
        "ConnectionString": "127.0.0.1:7000,allowAdmin=true,abortConnect=false",
        "GroupType": "Cluster",
        "AuthorizationOverrides": {
          "Mode": "ReplaceDefaults",
          "Rules": [
            { "Action": "DeleteKey", "AllowedRoles": [ "admin" ] }
          ]
        }
      }
    ]
  }
}
