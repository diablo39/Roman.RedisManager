        {
            "name": ".NET Core Launch (web)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "dotnet: build",
            // If you have changed target frameworks, make sure to update the program path.
            "program": "${workspaceFolder}/src/Roman.RedisManager.Web/bin/Debug/net10.0/Roman.RedisManager.Web.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/Roman.RedisManager.Web",
            "stopAtEntry": false,
            // Enable launching the browser with a specific URL based on your launchUrl and applicationUrl in launchSettings.json.
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            // Configure source file mapping if the sources are not under the workspace folder
            // "sourceFileMap": {
